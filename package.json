{
  "name": "dsh-pet-quota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 桌面宠物的今日 token 额度气泡：按用量分轻度/中度/重度三档，档位只用一个彩色圆点表示，没有进度条也没有百分比。 / Today's token quota bubble for the DSH desktop pet: three usage tiers shown as one coloured dot, with no progress bar and no percentage.",
  "main": "./entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tools/smoke_host.mjs",
    "tools/smoke_client.mjs",
    "tools/tier_backtest.py"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pet",
    "token-usage",
    "quota",
    "desktop-pet"
  ],
  "scripts": {
    "test": "node tools/smoke_host.mjs && node tools/smoke_client.mjs",
    "test:host": "node tools/smoke_host.mjs",
    "test:client": "node tools/smoke_client.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "author": "dsh-pet-quota contributors"
}

